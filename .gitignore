# Append-only logs that grow unbounded
.openclaw/operator/activity.jsonl
.openclaw/operator/spend.jsonl
.openclaw/processed-orders.jsonl

# Pipeline run history (can be 1–2 MB per run, accumulates)
.openclaw/runs.json

# Already-generated artifact PDFs (re-derivable from materialize)
.openclaw/materialized-products/*.pdf

# Local debug / test images
.openclaw/brand/debug-*.png
.openclaw/brand/.aop-linear-high-dpi-url.txt
.openclaw/brand/.aop-linear-padded-url.txt

# CEREBRO / Graphify generated artifacts — regenerable from code.
# Exception: GRAPH_REPORT.md is committed because the production
# CerebroHeartbeat dashboard reads it for live brain stats. Without
# this file shipping with the deploy, prod heartbeat shows null nodes.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
.openclaw/cerebro-usage.jsonl
.openclaw/cerebro-scrape-results.json

# Scraped external corpus — regenerable via scripts/cerebro-scrape-competitors.ts
raw/

